# ---------------------------------------------------------------------------
# Shanyraq Hub environment variables
# Copy to .env.local for local development. Never commit real values.
# Variables prefixed with VITE_ are embedded into the PUBLIC browser bundle.
# ---------------------------------------------------------------------------

# --- Frontend (public, safe to expose) -------------------------------------
# Supabase project URL and the anon / publishable key (sb_publishable_... or the legacy
# "anon" JWT). NEVER the secret / service_role key. Security comes from RLS, not from
# hiding these values. Used in live mode for sign-in (stage 5); demo mode ignores them.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Public VAPID key for Web Push subscriptions (generate with `npx web-push generate-vapid-keys`).
VITE_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"

# Canonical public URL of the deployed app (links in notifications). E-mail links for
# sign-up / password reset return to the page's own origin, which must be listed in
# Supabase -> Authentication -> URL Configuration (Site URL / Redirect URLs).
VITE_APP_URL="http://localhost:3000"

# Data source: "demo" (default) = fictional demo data, labelled "Демо";
# "live" = real data only, demo records are never loaded (not even in the build).
# Production must use "live". Demo and live data are stored separately.
VITE_DATA_SOURCE="demo"

# Test-account switcher (header -> "Сменить тестовую роль"), demo data only.
# Default: on for `bun run dev`, off for production builds; never with live data.
# Every visitor always starts as a new first-tier member either way.
# VITE_DEMO_MODE="true"

# --- Server-only (Supabase Edge Function secrets / hosting secrets) --------
# NEVER prefix these with VITE_ and NEVER import them in src/.
# Set with: supabase secrets set NAME=value
# SUPABASE_SERVICE_ROLE_KEY="..."   # provided automatically inside Edge Functions
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:admin@example.com"
# TELEGRAM_BOT_TOKEN="..."
