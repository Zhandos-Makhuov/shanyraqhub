# ---------------------------------------------------------------------------
# Shanyraq Hub environment variables
# Copy to .env.local for local development. Never commit real values.
# Variables prefixed with VITE_ are embedded into the PUBLIC browser bundle.
# ---------------------------------------------------------------------------

# --- Frontend (public, safe to expose) -------------------------------------
# Supabase project URL and anon (publishable) key. Security comes from RLS,
# not from hiding these values. NOT YET USED by the app (see docs/ARCHITECTURE_AUDIT.md).
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Public VAPID key for Web Push subscriptions (generate with `npx web-push generate-vapid-keys`).
VITE_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"

# Canonical public URL of the deployed app (used for auth redirects / links).
VITE_APP_URL="http://localhost:3000"

# Demo mode: shows the test-account switcher (header -> "Сменить тестовую роль").
# Default: on for `bun run dev`, off for production builds. Every visitor always
# starts as a new first-tier member either way.
# VITE_DEMO_MODE="true"

# --- Server-only (Supabase Edge Function secrets / hosting secrets) --------
# NEVER prefix these with VITE_ and NEVER import them in src/.
# Set with: supabase secrets set NAME=value
# SUPABASE_SERVICE_ROLE_KEY="..."   # provided automatically inside Edge Functions
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:admin@example.com"
# TELEGRAM_BOT_TOKEN="..."

# --- Legacy AI Studio template values (currently unused by src/) -----------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
