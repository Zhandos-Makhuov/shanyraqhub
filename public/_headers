# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
# Embedding: only this site and Telegram Web (the Mini App opens there in a frame); any other site is refused.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self' https://web.telegram.org
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# The service worker must always be re-checked so new deploys reach members quickly.
/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

# Build files (hashed names) and the logo: cache for a week.
/assets/*
  Cache-Control: public, max-age=604800
